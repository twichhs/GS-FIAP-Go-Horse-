# Copie para .env (não versionado) e preencha. Os scripts carregam este arquivo automaticamente.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do agente GenAI (padrão: anthropic:claude-opus-5-5). Outros exemplos:
#   CITIZENTECH_LLM=anthropic:claude-sonnet-5-5
#   CITIZENTECH_LLM=openai:gpt-5          (exige OPENAI_API_KEY e pip install langchain-openai)
#   CITIZENTECH_LLM=google_genai:gemini-2.5-pro   (exige GOOGLE_API_KEY e pip install langchain-google-genai)
# CITIZENTECH_LLM=anthropic:claude-opus-5-5

# IoT (opcional): base dos tópicos MQTT (igual ao firmware) e alertas no Telegram
# MQTT_BASE=fiap/citizentech/grupoX
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# GenAI: 1 = simula o envio do alerta MQTT (sem rede)
# CITIZENTECH_MQTT_DRY_RUN=1
